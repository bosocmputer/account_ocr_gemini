# ===========================================
# Go-Receipt-Parser Configuration
# ===========================================

# ------------------------------------------
# Gemini AI Configuration (REQUIRED)
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=8080
GIN_MODE=release

# ------------------------------------------
# MongoDB Configuration
# ------------------------------------------
# Full connection URI with authentication
# Format: mongodb://username:password@host:port/?authSource=admin
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=your_database_name

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
# Use "*" for development, specific domain for production
ALLOWED_ORIGINS=*

# ------------------------------------------
# File Upload Configuration
# ------------------------------------------
UPLOAD_DIR=uploads

# ------------------------------------------
# Image Processing Configuration
# ------------------------------------------
ENABLE_IMAGE_PREPROCESSING=true
MAX_IMAGE_DIMENSION=2000

# ------------------------------------------
# OCR Worker Configuration
# ------------------------------------------
# How many images within one request are OCR'd concurrently. The Gemini rate
# limiter (internal/ratelimit) already caps total API request rate on its
# own, independent of this — raising this only lets network+inference
# latency overlap across images, it doesn't risk more 429s.
OCR_WORKER_COUNT=3

# ------------------------------------------
# Batch Background OCR Configuration
# ------------------------------------------
# Throughput is bounded by internal/ratelimit's global Gemini quota
# (~12 calls/min for the whole process), not by these settings — raising
# BATCH_OCR_CONCURRENCY does not make a batch finish faster, it only takes
# more of that shared quota away from interactive users.
BATCH_OCR_ENABLED=true
BATCH_OCR_CONCURRENCY=1
BATCH_OCR_MAX_ITEMS=100
BATCH_OCR_ITEM_DELAY_MS=2000
BATCH_OCR_MAX_ATTEMPTS=2
BATCH_OCR_ITEM_TIMEOUT_SEC=300
BATCH_OCR_STALE_LEASE_SEC=900
BATCH_OCR_COLLECTION=batch_ocr_runs

# Collection owned by the main API team — do not create indexes on it.
DOCUMENT_IMAGE_GROUP_COLLECTION=documentImageGroups
